# Environment — never commit credentials

# Uploaded user content
uploads/gallery/*
uploads/thumbnails/*
uploads/profile/*
!uploads/gallery/.gitkeep
!uploads/thumbnails/.gitkeep
!uploads/profile/.gitkeep

# Logs
*.log
logs/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Composer (if added later)
vendor/
composer.lock

# Temp / backup files
*.bak
*.tmp
*.orig
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
config.bat
node_modules
