# VK Tent Services — Environment Configuration Template
# Copy this file to .env and fill in your values.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="VK Tent Services"
APP_VERSION="1.0.0"
APP_ENV=development
BASE_URL=http://localhost/SamastamTechnologies/vk-tent-services

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vk_tent_services
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE=8
MAX_VIDEO_SIZE=100
THUMB_WIDTH=400
THUMB_HEIGHT=300
